# Fill these in, then restart `npm run dev`.
# Dashboard: http://127.0.0.1:5173
# Webhook, if you expose this machine: http://<public-host>/api/telnyx/webhook
 
TELNYX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_CONNECTION_ID=xxxxxxxxxxxxxxxxxxxxxxx

TELNYX_PHONE_NUMBER=xxxxxxxxxxxxxxxxx
# Optional. Leave blank and the server creates one credential on the connection and reuses it.
TELNYX_TELEPHONY_CREDENTIAL_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Calls are recorded automatically after they connect. Set to off to stop asking Telnyx to record.
TELNYX_RECORDING=on

GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

PORT=8787

